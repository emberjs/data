{
  "name": "@ember-data/codemods",
  "version": "5.10.0-alpha.19",
  "description": "Codemods for WarpDrive/EmberData paradigms",
  "keywords": [],
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com:warp-drive-data/warp-drive.git",
    "directory": "packages/codemods"
  },
  "type": "module",
  "bin": {
    "codemods": "./dist/index.js"
  },
  "engines": {
    "node": ">=24.22.0"
  },
  "scripts": {
    "sync": "echo \"syncing\"",
    "build:pkg": "node node_modules/tsdown/dist/run.mjs",
    "prepack": "pnpm run build:pkg",
    "check:types": "node ./node_modules/typescript-7/bin/tsc --noEmit"
  },
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./schema-migration/*": {
      "default": "./src/schema-migration/*"
    }
  },
  "files": [
    "dist/index.js",
    "src",
    "utils",
    "LICENSE.md",
    "logos"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@ast-grep/napi": "^0.51.0"
  },
  "devDependencies": {
    "@types/jscodeshift": "catalog:",
    "@types/node": "catalog:",
    "@warp-drive/internal-config": "workspace:*",
    "commander": "catalog:",
    "eslint": "catalog:",
    "ignore": "catalog:",
    "jscodeshift": "catalog:",
    "tsdown": "catalog:",
    "typescript-7": "catalog:",
    "winston": "catalog:"
  }
}
