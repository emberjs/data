{
  "name": "@ember-data/store",
  "version": "5.10.0-alpha.17",
  "description": "(Legacy) EmberData `Store` class that coordinates the cache, the `RequestManager` and record presentation; new apps should use the `Store` from `@warp-drive/core` instead.",
  "keywords": [
    "ember-addon"
  ],
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com:warp-drive-data/warp-drive.git",
    "directory": "packages/store"
  },
  "license": "MIT",
  "author": "Chris Thoburn <runspired@users.noreply.github.com>",
  "files": [
    "addon-main.cjs",
    "dist",
    "README.md",
    "LICENSE.md",
    "logos"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "check:types": "node ./node_modules/typescript-7/bin/tsc --noEmit",
    "build:pkg": "node node_modules/tsdown/dist/run.mjs",
    "prepack": "pnpm run build:pkg",
    "sync": "echo \"syncing\"",
    "start": "node node_modules/tsdown/dist/run.mjs --watch"
  },
  "type": "module",
  "dependencies": {
    "@embroider/macros": "^1.21.3",
    "@warp-drive/core": "workspace:*"
  },
  "peerDependencies": {
    "@ember-data/tracking": "workspace:*",
    "@ember/test-waiters": "^3.1.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "@ember-data/tracking": {
      "optional": true
    },
    "@ember/test-waiters": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babel/core": "catalog:",
    "@babel/plugin-transform-typescript": "catalog:",
    "@babel/preset-env": "catalog:",
    "@babel/preset-typescript": "catalog:",
    "@ember-data/tracking": "workspace:*",
    "@ember/test-waiters": "catalog:",
    "@warp-drive/internal-config": "workspace:*",
    "ember-source": "catalog:",
    "tsdown": "catalog:",
    "typescript-7": "catalog:"
  },
  "ember-addon": {
    "main": "addon-main.cjs",
    "type": "addon",
    "version": 2
  },
  "ember": {
    "edition": "octane"
  }
}
