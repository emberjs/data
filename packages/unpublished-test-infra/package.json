{
  "name": "@ember-data/unpublished-test-infra",
  "version": "5.10.0-alpha.17",
  "private": true,
  "description": "The default blueprint for ember-data private packages.",
  "keywords": [
    "ember-addon"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/warp-drive-data/warp-drive.git",
    "directory": "packages/unpublished-test-infra"
  },
  "license": "MIT",
  "author": "",
  "files": [
    "addon-main.cjs",
    "testem",
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testem/*": {
      "default": "./testem/*.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "directories": {
    "doc": "doc",
    "test": "tests"
  },
  "scripts": {
    "build:pkg": "node node_modules/tsdown/dist/run.mjs",
    "prepack": "pnpm run build:pkg",
    "sync": "echo \"syncing\"",
    "check:types": "node ./node_modules/typescript-7/bin/tsc --noEmit"
  },
  "type": "module",
  "peerDependencies": {
    "@ember/test-helpers": "3.3.0 || ^4.0.4 || ^5.1.0",
    "@warp-drive/diagnostic": "workspace:*",
    "qunit": "catalog:",
    "testem": "catalog:"
  },
  "peerDependenciesMeta": {
    "qunit": {
      "optional": true
    },
    "testem": {
      "optional": true
    },
    "@warp-drive/diagnostic": {
      "optional": true
    }
  },
  "dependencies": {
    "@embroider/macros": "catalog:",
    "@warp-drive/core": "workspace:*",
    "@warp-drive/utilities": "workspace:*",
    "semver": "catalog:"
  },
  "devDependencies": {
    "@babel/core": "catalog:",
    "@babel/plugin-transform-typescript": "catalog:",
    "@babel/preset-env": "catalog:",
    "@babel/preset-typescript": "catalog:",
    "@ember/test-helpers": "catalog:",
    "@glimmer/component": "catalog:",
    "@types/qunit": "catalog:",
    "@types/semver": "catalog:",
    "@warp-drive/diagnostic": "workspace:*",
    "@warp-drive/internal-config": "workspace:*",
    "ember-source": "catalog:",
    "qunit": "catalog:",
    "testem": "catalog:",
    "tsdown": "catalog:",
    "typescript-7": "catalog:"
  },
  "ember": {
    "edition": "octane"
  },
  "ember-addon": {
    "main": "addon-main.cjs",
    "type": "addon",
    "version": 2
  }
}
