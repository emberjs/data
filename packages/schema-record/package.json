{
  "name": "@warp-drive/schema-record",
  "version": "5.10.0-alpha.18",
  "description": "(Legacy) Re-export of the reactive-resource API such as `SchemaService`, `instantiateRecord` and `withDefaults`; new code should import these from `@warp-drive/core/reactive`.",
  "keywords": [
    "ember-addon"
  ],
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com:warp-drive-data/warp-drive.git",
    "directory": "packages/schema-record"
  },
  "license": "MIT",
  "author": "",
  "scripts": {
    "check:types": "node ./node_modules/typescript-7/bin/tsc --noEmit",
    "build:pkg": "node node_modules/tsdown/dist/run.mjs",
    "prepack": "pnpm run build:pkg",
    "sync": "echo \"syncing\"",
    "start": "node node_modules/tsdown/dist/run.mjs --watch"
  },
  "ember-addon": {
    "main": "addon-main.cjs",
    "type": "addon",
    "version": 2
  },
  "files": [
    "addon-main.cjs",
    "dist",
    "README.md",
    "LICENSE.md",
    "logos"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "dependencies": {
    "@embroider/macros": "^1.21.3",
    "@warp-drive/core": "workspace:*"
  },
  "devDependencies": {
    "@babel/core": "catalog:",
    "@babel/plugin-transform-typescript": "catalog:",
    "@babel/preset-env": "catalog:",
    "@babel/preset-typescript": "catalog:",
    "@warp-drive/internal-config": "workspace:*",
    "tsdown": "catalog:",
    "typescript-7": "catalog:"
  },
  "ember": {
    "edition": "octane"
  }
}
