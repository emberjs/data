{
  "name": "@warp-drive/diagnostic",
  "version": "0.0.3-alpha.178",
  "private": true,
  "description": "⚡️ A Lightweight Modern Test Runner",
  "keywords": [
    "test",
    "assert",
    "testrunner",
    "tap",
    "reporter",
    "junit",
    "qunit",
    "vitest",
    "jest",
    "mocha",
    "chai",
    "ember-addon"
  ],
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com:warp-drive-data/warp-drive.git",
    "directory": "packages/diagnostic"
  },
  "license": "MIT",
  "author": "Chris Thoburn <runspired@users.noreply.github.com>",
  "files": [
    "addon-main.cjs",
    "dist/",
    "dist-server/",
    "README.md",
    "LICENSE.md",
    "logos"
  ],
  "exports": {
    "./server": {
      "node": "./dist-server/index.js",
      "bun": "./dist-server/index.js",
      "deno": "./dist-server/index.js",
      "default": "./dist-server/index.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*.css": {
      "default": "./dist/*.css"
    },
    "./server/*": {
      "node": "./dist-server/*.js",
      "bun": "./dist-server/*.js",
      "deno": "./dist-server/*.js"
    },
    "./ember": {
      "types": "./dist/ember.d.ts",
      "default": "./dist/ember.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build:tests": "rm -rf dist-test && cp -R test dist-test && mkdir -p dist-test/@warp-drive && cp -R dist dist-test/@warp-drive/diagnostic",
    "build:pkg": "NODE_ENV=production node node_modules/tsdown/dist/run.mjs && NODE_ENV=production node node_modules/tsdown/dist/run.mjs -c ./tsdown.config-server.mjs",
    "prepack": "pnpm run build:pkg",
    "sync": "echo \"syncing\"",
    "start": "node node_modules/tsdown/dist/run.mjs --watch"
  },
  "type": "module",
  "peerDependencies": {
    "@ember/test-helpers": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "peerDependenciesMeta": {
    "@ember/test-helpers": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "dependencies": {
    "@embroider/macros": "catalog:",
    "@warp-drive/core": "workspace:*",
    "@warp-drive/react": "workspace:*",
    "debug": "catalog:",
    "dom-element-descriptors": "catalog:",
    "hono": "catalog:",
    "@hono/node-server": "catalog:",
    "@hono/node-ws": "catalog:",
    "qunit-dom": "catalog:"
  },
  "devDependencies": {
    "@babel/core": "catalog:",
    "@babel/plugin-transform-typescript": "catalog:",
    "@babel/preset-env": "catalog:",
    "@babel/preset-react": "catalog:",
    "@babel/preset-typescript": "catalog:",
    "@babel/runtime": "catalog:",
    "@ember/test-helpers": "catalog:",
    "@glimmer/component": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@warp-drive/internal-config": "workspace:*",
    "@types/debug": "catalog:",
    "@types/node": "catalog:",
    "ember-source": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "ember-addon": {
    "main": "addon-main.cjs",
    "type": "addon",
    "version": 2
  },
  "ember": {
    "edition": "octane"
  }
}
