{
  "name": "@warp-drive/internal-tooling",
  "version": "5.10.0-alpha.19",
  "description": "Internal Tooling for the WarpDrive Project Monorepo | Unpublished",
  "private": true,
  "type": "module",
  "files": [
    "bin",
    "src"
  ],
  "scripts": {
    "build:pkg": "node src/sync-logos.ts",
    "check:types": "tsc --noEmit",
    "prepack": "pnpm run build:pkg",
    "test": "node --test tests/*.spec.ts"
  },
  "bin": {
    "sync-logos": "bin/sync-logos.mjs",
    "sync-license": "bin/sync-license.mjs",
    "sync-references": "bin/sync-references.mjs",
    "sync-readme-tables": "bin/sync-readme-tables.mjs",
    "sync-scripts": "bin/sync-scripts.mjs",
    "sync-all": "bin/sync-all.mjs"
  },
  "dependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "debug": "catalog:",
    "@types/debug": "catalog:",
    "@babel/parser": "catalog:",
    "@babel/traverse": "catalog:",
    "comment-json": "catalog:",
    "@pnpm/find-workspace-dir": "catalog:",
    "@pnpm/find-workspace-packages": "catalog:",
    "@pnpm/logger": "catalog:"
  }
}
