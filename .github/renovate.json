{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices"],
  "labels": [":dependabot:", ":label: dependencies"],
  "dependencyDashboardLabels": [":label: dependencies"],
  "dependencyDashboardOSVVulnerabilitySummary": "unresolved",
  "dependencyDashboardHeader": "### A note on \"Pending Status Checks\"\n\nAnything listed below under **Pending Status Checks** is not stuck or broken -- it's being intentionally held back by our `minimumReleaseAge` policy (currently `3 days`; see the top of this file), which delays proposing a version until it's been out long enough for the ecosystem to catch and pull a compromised release. Renovate will automatically open the branch/PR as soon as that window passes -- no action is needed here.\n\nSecurity-fix updates (`vulnerabilityAlerts` / OSV) bypass `minimumReleaseAge` entirely and are raised immediately, so anything held in Pending Status Checks is a routine version bump, never a security fix stuck waiting.",
  "osvVulnerabilityAlerts": true,
  "packageRules": [
    {
      "matchPackageNames": [
        "ember-source",
        "ember-resolver",
        "loader.js",
        "ember-classic-decorator",
        "ember-cached-decorator",
        "ember-modifier",
        "ember-page-title",
        "tracked-built-ins",
        "/glimmer/",
        "/polyfill/"
      ],
      "groupName": "ember-core"
    },
    {
      "matchPackageNames": ["/@types\/ember/"],
      "groupName": "legacy-ember-types"
    },
    {
      "matchPackageNames": ["node", "@types/node"],
      "groupName": "dev-engines"
    },
    {
      "matchPackageNames": ["typescript", "globals", "/^@glint\\//", "ember-content-mapper"],
      "groupName": "typescript"
    },
    {
      "matchPackageNames": ["/qunit/"],
      "groupName": "qunit"
    },
    {
      "matchPackageNames": ["/eslint/"],
      "groupName": "eslint"
    },
    {
      "matchPackageNames": [
        "oxlint",
        "oxfmt",
        "/^oxlint-/",
        "/^oxc-/",
        "/^@oxlint\\//",
        "/^@oxfmt\\//",
        "/^@oxc-project\\//"
      ],
      "groupName": "oxc"
    },
    {
      "matchPackageNames": ["/vite/", "/rollup/", "/rolldown/", "/tsdown/", "/unplugin/"],
      "groupName": "build-tools"
    },
    {
      "description": "Keep svelte and @sveltejs/* (kit, package, vite-plugin-svelte) in one group; listed after build-tools so @sveltejs/vite-plugin-svelte lands here rather than matching /vite/",
      "matchPackageNames": ["svelte", "/^svelte-/", "/^@sveltejs\\//"],
      "groupName": "svelte"
    },
    {
      "matchPackageNames": [
        "/typedoc/",
        "/vitepress/",
        "vite-plugin-pwa",
        "@mdit/plugin-footnote",
        "vite-plugin-image-optimizer",
        "svgo",
        "sharp",
        "front-matter"
      ],
      "groupName": "docs"
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "github-actions"
    },
    {
      "matchFileNames": ["pnpm-lock.yaml"],
      "rebaseWhen": "behind-base-branch"
    }
  ],
  "lockFileMaintenance": {
    "rebaseWhen": "behind-base-branch"
  },
  "minimumReleaseAge": "3 days",
  "rangeStrategy": "bump",
  "prHourlyLimit": 10,
  "branchConcurrentLimit": 12,
  "vulnerabilityAlerts": {
    "labels": [":label: security"],
    "automerge": false,
    "assignees": ["@runspired"],
    "enabled": true
  }
}
