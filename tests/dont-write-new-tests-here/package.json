{
  "name": "main-test-app",
  "version": "5.10.0-alpha.17",
  "private": true,
  "description": "A data layer for your Ember applications.",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com:warp-drive-data/warp-drive.git",
    "directory": "tests/dont-write-new-tests-here"
  },
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "sync": "echo \"syncing\"",
    "build:tests": "NODE_ENV=development IS_TESTING=true EMBER_CLI_TEST_COMMAND=true vite build --mode development --outDir dist-test",
    "build:production": "FORCE_BUILD_TESTS=true NODE_ENV=production IS_TESTING=true EMBER_CLI_TEST_COMMAND=true vite build --mode production --outDir dist-test",
    "lint": "eslint . --quiet --cache --cache-strategy=content",
    "check:types": "node ./node_modules/typescript-7/bin/tsc --noEmit --runExternalCode",
    "examine": "export EXAM_PARALLEL_COUNT=$(./bin/calculate-test-jobs); warp-drive-exam --test-port=0 --path=dist-test --parallel=$EXAM_PARALLEL_COUNT --load-balance",
    "launch:tests": "warp-drive-exam --test-port=0 --path=dist-test --server --no-launch",
    "start": "pnpm run build:tests --watch",
    "test": "pnpm run examine",
    "test:production": "pnpm run examine",
    "test:start": "warp-drive-exam --test-port=0 --path=dist-test --server --no-launch"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "catalog:",
    "@babel/plugin-transform-runtime": "catalog:",
    "@babel/plugin-transform-typescript": "catalog:",
    "@babel/runtime": "catalog:",
    "@ember-data/adapter": "workspace:*",
    "@ember-data/debug": "workspace:*",
    "@ember-data/graph": "workspace:*",
    "@ember-data/json-api": "workspace:*",
    "@ember-data/legacy-compat": "workspace:*",
    "@ember-data/model": "workspace:*",
    "@ember-data/request": "workspace:*",
    "@ember-data/request-utils": "workspace:*",
    "@ember-data/serializer": "workspace:*",
    "@ember-data/store": "workspace:*",
    "@ember-data/unpublished-test-infra": "workspace:*",
    "@ember/app-tsconfig": "catalog:",
    "@ember/edition-utils": "catalog:",
    "@ember/optional-features": "catalog:",
    "@ember/string": "catalog:",
    "@ember/test-helpers": "catalog:",
    "@ember/test-waiters": "catalog:",
    "@embroider/config-meta-loader": "catalog:",
    "@embroider/core": "catalog:",
    "@embroider/macros": "catalog:",
    "@embroider/vite": "catalog:",
    "@glimmer/component": "catalog:",
    "@glint/ember-tsc": "catalog:",
    "@glint/template": "catalog:",
    "@types/qunit": "catalog:",
    "@warp-drive/build-config": "workspace:*",
    "@warp-drive/core": "workspace:*",
    "@warp-drive/core-types": "workspace:*",
    "@warp-drive/ember": "workspace:*",
    "@warp-drive/holodeck": "workspace:*",
    "@warp-drive/internal-config": "workspace:*",
    "@warp-drive/internal-exam": "workspace:*",
    "@warp-drive/json-api": "workspace:*",
    "@warp-drive/legacy": "workspace:*",
    "@warp-drive/schema-record": "workspace:*",
    "@warp-drive/utilities": "workspace:*",
    "babel-plugin-ember-template-compilation": "catalog:",
    "decorator-transforms": "catalog:",
    "ember-content-mapper": "catalog:",
    "ember-data": "workspace:*",
    "ember-inflector": "catalog:",
    "ember-qunit": "catalog:",
    "ember-route-template": "catalog:",
    "ember-source": "catalog:",
    "ember-source-channel-url": "catalog:",
    "ember-strict-application-resolver": "catalog:",
    "pretender": "catalog:",
    "qunit": "catalog:",
    "qunit-dom": "catalog:",
    "testem": "catalog:",
    "typescript": "catalog:",
    "typescript-7": "catalog:",
    "vite": "catalog:"
  },
  "ember": {
    "edition": "octane"
  },
  "exports": {
    "./tests/*": "./tests/*",
    "./*": "./app/*"
  }
}
