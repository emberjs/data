{
  "name": "@warp-drive/internal-docs-viewer",
  "version": "5.10.0-alpha.18",
  "description": "API Docs Viewer for the WarpDrive Project Monorepo | Unpublished",
  "private": true,
  "type": "module",
  "files": [
    "src"
  ],
  "bin": {
    "sync-guides": "./src/sync-guides.ts"
  },
  "scripts": {
    "start": "node ./src/sync-guides.ts",
    "build": "node ./src/sync-guides.ts --build --force",
    "check:links": "node ./src/check-content-links.ts",
    "preview": "vitepress preview docs.warp-drive.io",
    "test": "node --test tests/*.spec.ts",
    "check:types": "tsc --noEmit"
  },
  "dependencies": {
    "vitepress": "catalog:",
    "vitepress-plugin-mermaid": "catalog:",
    "mermaid": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "debug": "catalog:",
    "@mdit/plugin-footnote": "catalog:",
    "@pnpm/find-workspace-packages": "catalog:",
    "@pnpm/logger": "catalog:",
    "@jridgewell/trace-mapping": "catalog:",
    "@types/debug": "catalog:",
    "@vite-pwa/vitepress": "catalog:",
    "front-matter": "catalog:",
    "markdown-title": "catalog:",
    "sharp": "catalog:",
    "svgo": "catalog:",
    "typedoc": "catalog:",
    "typedoc-plugin-markdown": "catalog:",
    "typedoc-plugin-no-inherit": "catalog:",
    "typedoc-plugin-mdn-links": "catalog:",
    "typedoc-vitepress-theme": "catalog:",
    "vitepress-plugin-llms": "catalog:",
    "vitepress-plugin-group-icons": "catalog:",
    "vitepress-plugin-tabs": "catalog:",
    "vite-plugin-image-optimizer": "catalog:",
    "vite-plugin-pwa": "catalog:",
    "vue": "catalog:",
    "vite": "catalog:",
    "execa": "catalog:"
  }
}
